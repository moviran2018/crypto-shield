{
  "name": "crypto-shield",
  "version": "4.0.0",
  "private": true,
  "description": "Crypto Shield - White-Label Blockchain Security Platform",
  "workspaces": [
    "modules/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/frontend",
    "build": "npm run build --workspace=apps/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --local > apps/frontend/src/lib/database.types.ts",
    "deploy:workers": "npm run deploy --workspace=workers/api && npm run deploy --workspace=workers/scheduler",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.12.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
